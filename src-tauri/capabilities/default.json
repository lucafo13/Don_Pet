
{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for application windows",
  "windows": [
    "main",
    "janela-musica",
    "janela-musica-2"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "core:webview:allow-create-webview-window",
    "fs:default",
    "fs:allow-read-dir",
    {
      "identifier": "fs:scope",
      "allow": [
        "C:/Users/Davi/**"
      ]
    }
  ]
}
